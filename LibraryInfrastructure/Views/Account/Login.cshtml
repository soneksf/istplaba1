@model LibraryInfrastructure.ViewModel.LoginViewModel

<h2>Вхід</h2>

<form asp-controller="Account" asp-action="Login" method="post" asp-route-returnUrl="@Model.ReturnUrl">
    <div asp-validation-summary="ModelOnly"></div>
    <div>
        <label asp-for="Email"></label><br />
        <input asp-for="Email" />
        <span asp-validation-for="Email"></span>
    </div>
    <div>
        <label asp-for="Password"></label><br />
        <input asp-for="Password" type="password" />
        <span asp-validation-for="Password"></span>
    </div>
    <div>
        <label asp-for="RememberMe"></label>
        <input asp-for="RememberMe" type="checkbox" />
    </div>
    <div>
        <input type="submit" value="Увійти" />
    </div>
    <p>
        <a asp-controller="Account" asp-action="ForgotPassword">Забули пароль?</a>
    </p>

</form>
