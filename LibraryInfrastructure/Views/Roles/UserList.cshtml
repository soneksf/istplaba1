@model IEnumerable<LibraryDomain.Models.User>

<h2>Список користувачів</h2>
<table class="table">
    @foreach (var user in Model)
    {
        <tr>
            <td>@user.Email</td>
            <td>
                <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-userid="@user.Id">Права доступу</a>
                <span> | </span>
                <a class="btn btn-sm btn-danger" asp-action="DeleteUser" asp-route-userid="@user.Id">Видалити</a>

            </td>
        </tr>
    }
</table>
