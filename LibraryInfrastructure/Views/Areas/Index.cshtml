@model IEnumerable<LibraryDomain.Models.Area>

@{
    ViewData["Title"] = "Область наукової роботи";
}

<h1>Область наукової роботи</h1>

@if (TempData["DeleteError"] != null)
{
    <div class="alert alert-danger">
        @TempData["DeleteError"]
    </div>
}


@if (User.IsInRole("admin"))
{
    <p>
        <a asp-action="Create">Створити нову</a>
    </p>
}

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.AreaName)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.AreaName)
                </td>
                <td>
                    
                    @if (User.IsInRole("admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id">Змінити</a>
                        <span> | </span>
                    }

                   
                    <a asp-action="Details" asp-route-id="@item.Id">Деталі</a>

                    @if (User.IsInRole("admin"))
                    {
                        <span> | </span>
                        <a asp-action="Delete" asp-route-id="@item.Id">Видалити</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
